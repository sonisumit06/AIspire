# ==============================================================================
# AIspire Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Project Anon / Public Key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Side Only: Google Gemini API Key
# Handled securely via server-side / edge proxy (/api/ai-mentor). Never exposed to browser bundle.
GEMINI_API_KEY=
